[DEFAULT]
banaction  = iptables-allports
ignoreip   = 127.0.0.1/8
usedns     = no
backend    = polling

bantime = 10m
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 1d
bantime.rndtime = 30s

[ldap-flood]
enabled  = true
port     = 389,636
filter   = ldap-flood
logpath  = /var/log/openldap/slapd.log
maxretry = 60
findtime = 10s